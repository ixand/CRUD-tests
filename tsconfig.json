{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "pages/**/*.ts", "data/**/*.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
